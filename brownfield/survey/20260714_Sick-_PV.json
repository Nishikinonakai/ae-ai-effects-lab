  "// 每個詞組的字元數,對應「今日は/とても/良い/天気です」\rvar groups = [3, 3, 2, 3, 2];\rvar t = effect(\"進度\")(1); // (1) = 效果的第一個屬性,不受界面語言影響\rvar idx = textIndex - 1;\rvar g = 0, acc = 0;\rfor (var i = 0; i < groups.length; i++){\r  acc += groups[i];\r  if (idx < acc){ g = i; break; }\r}\r// 該詞組的顯示進度:0=完全出現,100=完全隱藏\r(g < t) ? 0 : 100;",
  "effect(\"進度\")(1)",
  "loopOut(\"offset\")",
  "txt = value;\rn = txt.length;\rdur = (outPoint - inPoint) * 0.3;   // 只用前 20% 时长来打字\rt = clamp((time - inPoint) / dur, 0, 1);\rtxt.substr(0, Math.floor(t * n));",
  "txt = value;\rn = txt.length;\rdur = (outPoint - inPoint) * 0.4;   // 只用前 20% 时长来打字\rt = clamp((time - inPoint) / dur, 0, 1);\rtxt.substr(0, Math.floor(t * n));",
